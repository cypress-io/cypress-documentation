{
  // Must match the Worker name in the Cloudflare dashboard, or builds fail.
  "name": "cypress-documentation",
  "compatibility_date": "2026-10-21",
  "assets": {
    // `npm run build` writes to dist/, not Docusaurus's default build/.
    "directory": "./dist",
    "not_found_handling": "404-page",
    // Serve docs/foo/index.html at /foo, matching the URLs Netlify serves today.
    "html_handling": "drop-trailing-slash",
  },
}
